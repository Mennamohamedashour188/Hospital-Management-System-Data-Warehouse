          SQLTask:SqlStatementSource="-- Disable FK constraints on fact tables only&#xA;ALTER TABLE HospitalDWH.dbo.F_Procedures NOCHECK CONSTRAINT ALL&#xA;ALTER TABLE HospitalDWH.dbo.F_Encounters NOCHECK CONSTRAINT ALL&#xA;ALTER TABLE HospitalDWH.dbo.F_Insurance NOCHECK CONSTRAINT ALL&#xA;&#xA;-- Delete fact tables&#xA;DELETE FROM HospitalDWH.dbo.F_Procedures&#xA;DELETE FROM HospitalDWH.dbo.F_Encounters&#xA;DELETE FROM HospitalDWH.dbo.F_Insurance&#xA;&#xA;-- Re-enable FK constraints&#xA;ALTER TABLE HospitalDWH.dbo.F_Procedures WITH CHECK CHECK CONSTRAINT ALL&#xA;ALTER TABLE HospitalDWH.dbo.F_Encounters WITH CHECK CHECK CONSTRAINT ALL&#xA;ALTER TABLE HospitalDWH.dbo.F_Insurance WITH CHECK CHECK CONSTRAINT ALL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
