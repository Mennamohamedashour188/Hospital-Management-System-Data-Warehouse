                          expressionType="Notify"
                          name="FriendlyExpression">(DT_STR,10,1252)YEAR(StartTime) + "-" + RIGHT("0" + (DT_STR,2,1252)MONTH(StartTime),2) + "-" + RIGHT("0" + (DT_STR,2,1252)DAY(StartTime),2)</property>
