                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_STR,10,1252)YEAR(#{Package\Load F_Procedures\STG Procedures.Outputs[OLE DB Source Output].Columns[StartTime]}) + "-" + RIGHT("0" + (DT_STR,2,1252)MONTH(#{Package\Load F_Procedures\STG Procedures.Outputs[OLE DB Source Output].Columns[StartTime]}),2) + "-" + RIGHT("0" + (DT_STR,2,1252)DAY(#{Package\Load F_Procedures\STG Procedures.Outputs[OLE DB Source Output].Columns[StartTime]}),2)</property>
