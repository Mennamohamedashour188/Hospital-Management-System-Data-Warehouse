                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">([ISNULL](#{Package\Load Insurance Facts to DWH\OLE DB Source.Outputs[OLE DB Source Output].Columns[Total_Claim_Cost]}) ? (DT_R8)0 : #{Package\Load Insurance Facts to DWH\OLE DB Source.Outputs[OLE DB Source Output].Columns[Total_Claim_Cost]}) - ([ISNULL](#{Package\Load Insurance Facts to DWH\OLE DB Source.Outputs[OLE DB Source Output].Columns[Payer_Coverage]}) ? (DT_R8)0 : #{Package\Load Insurance Facts to DWH\OLE DB Source.Outputs[OLE DB Source Output].Columns[Payer_Coverage]})</property>
