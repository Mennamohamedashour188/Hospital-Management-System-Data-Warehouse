                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">([ISNULL](#{Package\Load Insurance Facts to DWH\OLE DB Source.Outputs[OLE DB Source Output].Columns[Total_Claim_Cost]}) || #{Package\Load Insurance Facts to DWH\OLE DB Source.Outputs[OLE DB Source Output].Columns[Total_Claim_Cost]} == 0) ? (DT_R8)0 : (([ISNULL](#{Package\Load Insurance Facts to DWH\OLE DB Source.Outputs[OLE DB Source Output].Columns[Payer_Coverage]}) ? (DT_R8)0 : #{Package\Load Insurance Facts to DWH\OLE DB Source.Outputs[OLE DB Source Output].Columns[Payer_Coverage]}) / #{Package\Load Insurance Facts to DWH\OLE DB Source.Outputs[OLE DB Source Output].Columns[Total_Claim_Cost]}) * 100.0</property>
