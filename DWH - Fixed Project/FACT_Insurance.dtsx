                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(ISNULL(Total_Claim_Cost) || Total_Claim_Cost == 0) ? (DT_R8)0 : ((ISNULL(Payer_Coverage) ? (DT_R8)0 : Payer_Coverage) / Total_Claim_Cost) * 100.0</property>
