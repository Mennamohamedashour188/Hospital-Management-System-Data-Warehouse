          SQLTask:Connection="{BE4DEF01-CD00-43C9-B1D7-A2E3811E6C37}"
          SQLTask:SqlStatementSource="-- insert the static values if they don't already exist&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.DimEncounterType)&#xA;BEGIN&#xA;    INSERT INTO dbo.DimEncounterType (EncounterClass, Description, Category)&#xA;    VALUES&#xA;        ('ambulatory',  'Outpatient visit, no overnight stay',   'Outpatient'),&#xA;        ('outpatient',  'Scheduled outpatient procedure',        'Outpatient'),&#xA;        ('wellness',    'Routine wellness or preventive visit',  'Preventive'),&#xA;        ('urgentcare',  'Urgent care center visit',              'Urgent'),&#xA;        ('emergency',   'Emergency department visit',            'Emergency'),&#xA;        ('inpatient',   'Hospital admission, overnight stay',    'Inpatient'),&#xA;        ('hospice',     'End-of-life palliative care',           'Palliative')&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
