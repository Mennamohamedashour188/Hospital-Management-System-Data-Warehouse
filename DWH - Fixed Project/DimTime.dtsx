    public override void CreateNewOutputRows()
    {
        for (int h = 0; h < 24; h++)
        {
            for (int m = 0; m < 60; m++)
            {
                Output0Buffer.AddRow();
                Output0Buffer.TimeKey = (h * 100) + m;
                Output0Buffer.Hour = h;
                Output0Buffer.Minute = m;
                Output0Buffer.TimeLabel = h.ToString("D2") + ":" + m.ToString("D2");

                if (h >= 6 && h < 12)
                {
                    Output0Buffer.PeriodOfDay = "Morning";
                }
                else if (h >= 12 && h < 18)
                {
                    Output0Buffer.PeriodOfDay = "Afternoon";
                }
                else if (h >= 18 && h < 24)
                {
                    Output0Buffer.PeriodOfDay = "Evening";
                }
                else
                {
                    Output0Buffer.PeriodOfDay = "Night";
                }
            }
        }
    }

}
